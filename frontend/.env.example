# From your Supabase project: Settings -> API.
# The anon key is safe to ship in the frontend bundle - it identifies the
# project and is subject to Row Level Security (see supabase/migrations),
# it doesn't grant access on its own. NEVER put the service_role key here -
# that one bypasses RLS entirely and belongs only in Edge Function secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
